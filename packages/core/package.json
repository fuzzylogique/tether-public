{
  "name": "@tether/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts",
    "./db": "./src/db/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx src/db/applyTigerSql.ts --extensions && tsx src/db/push.ts && tsx src/db/applyTigerSql.ts",
    "db:plan": "tsx src/db/push.ts --plan",
    "db:seed": "tsx src/db/seed.ts",
    "demo:reset": "tsx src/db/reset.ts",
    "eval:plans": "tsx src/eval/plans.ts",
    "google:auth": "tsx src/scripts/google-auth.ts",
    "env:check": "tsx src/scripts/doctor.ts",
    "sheet:create": "tsx src/scripts/sheet-create.ts",
    "test:charts": "node --import tsx --test src/ui/charts/charts.test.ts",
    "google:share": "tsx src/scripts/google-share.ts",
    "instagram:check": "tsx src/scripts/instagram-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/genai": "^1.20.0",
    "drizzle-orm": "^0.44.0",
    "googleapis": "^160.0.0",
    "inngest": "^3.40.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
