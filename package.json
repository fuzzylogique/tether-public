{
  "name": "tether",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @tether/server dev",
    "dev:web": "pnpm --filter @tether/web dev",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3001/api/inngest",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @tether/core db:generate",
    "db:push": "pnpm --filter @tether/core db:push",
    "db:seed": "pnpm --filter @tether/core db:seed",
    "demo:reset": "pnpm --filter @tether/core demo:reset",
    "discord:register": "pnpm --filter @tether/server discord:register",
    "eval:plans": "pnpm --filter @tether/core eval:plans",
    "google:auth": "pnpm --filter @tether/core google:auth",
    "env:check": "pnpm --filter @tether/core env:check",
    "sheet:create": "pnpm --filter @tether/core sheet:create"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@google/genai",
      "protobufjs",
      "sharp"
    ]
  }
}
