# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host:5432/tdb?sslmode=require   # Tiger Cloud service URL
GEMINI_API_KEY=
GEMINI_MODEL_PLANNER=gemini-2.5-pro
GEMINI_MODEL_AGENT=gemini-2.5-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_EMBED=gemini-embedding-001

# ---- Inngest ----
INNGEST_EVENT_KEY=          # blank for local dev server
INNGEST_SIGNING_KEY=        # blank for local dev server
INNGEST_DEV=1               # send events to the local dev server (remove in prod)

# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=       # guild to register slash commands against during dev

# ---- Google (single organizer account, OAuth refresh token) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Auth0 (dashboard) ----
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=               # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# ---- Server ----
SERVER_PORT=3001
SERVER_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

# ---- Vultr Object Storage (S3 compatible) ----
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_BUCKET=tether-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
