# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host:5432/tdb?sslmode=require   # Tiger Cloud service URL
GEMINI_API_KEY=
GEMINI_API_KEYS=            # optional, comma-separated keys from OTHER Google accounts/projects; the runtime rotates when one hits its 20/day cap
GEMINI_MODEL_PLANNER=gemini-3.6-flash   # free tier: 3.7/3.8 flash are 20 req/day; Pro is 0
GEMINI_MODEL_AGENT=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite   # used automatically when a daily quota is exhausted
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image   # free tier quota is 0: posters need a paid key
GEMINI_MODEL_EMBED=gemini-embedding-001

# ---- Inngest ----
INNGEST_EVENT_KEY=          # blank for local dev server
INNGEST_SIGNING_KEY=        # blank for local dev server
INNGEST_DEV=1               # send events to the local dev server (remove in prod)

# ---- Cron monitors (monitor-tasks, poll-sponsor-mail) ----
# EXACTLY ONE process sets TETHER_RUN_CRONS=1 (the stage laptop or the Vultr VM). Everyone else
# leaves it unset: the DB and Gmail account are shared, and every dev server that registers the
# crons would nudge, escalate and dispatch the same emails again.
TETHER_RUN_CRONS=
MONITOR_TASKS_CRON=*/15 * * * *   # demo: */1 * * * *
MONITOR_MAIL_CRON=*/2 * * * *
NUDGE_INTERVAL_MIN=120            # minutes between nudges of the same task; demo: 2
ESCALATE_AFTER_NUDGES=2           # nudges before the coordination agent escalates to the lead
DIGEST_CRON=0 14 * * *            # daily inbox digest to #ops (14:00 UTC = 9am Toronto in November)
DIGEST_HOURS=24                   # how far back the digest looks

# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=       # guild to register slash commands against during dev

# ---- Seed / demo (pnpm db:seed, pnpm demo:reset) ----
SEED_ORG_NAME=HackTrent 2026
SEED_OWNER_DISCORD_ID=      # Discord user id that owns the seeded tasks (gets the overdue-task nudge DM)
SEED_LEAD_DISCORD_ID=       # Discord user id seeded as lead (escalations, lead-gated approvals)
SEED_OPS_CHANNEL_ID=        # channel id for org.channels.ops (escalations, cron run cards)
SEED_SPONSORSHIP_CHANNEL_ID=   # channel id for org.channels.sponsorship (inbound sponsor mail cards)
SEED_SPONSOR_EMAIL=         # a real inbox (a teammate) used as the Shopify contact so the Gmail watcher has something to match

# ---- Google (single organizer account, OAuth refresh token) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Instagram (Instagram API with Instagram Login; `pnpm instagram:check` verifies) ----
INSTAGRAM_ACCESS_TOKEN=     # shared team secret (never commit it): ask whoever set up the Meta app, or regenerate under Instagram API → API setup with Unified login
INSTAGRAM_USER_ID=17841439718177709   # @tether_events, the org account everyone posts as (public id, not a secret)
INSTAGRAM_GRAPH_VERSION=v24.0

# ---- Auth0 (dashboard) ----
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=               # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# ---- Server ----
SERVER_PORT=3001
SERVER_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

# ---- Vultr VM (infra/vultr-create.sh creates it, infra/deploy.sh deploys; see infra/docker-compose.yml) ----
VULTR_API_KEY=              # Vultr → Account → API; only needed on the machine that runs vultr-create.sh
DOMAIN=                     # public hostname Caddy serves; deploy.sh fills in <ip>.sslip.io when blank

# ---- Vultr Object Storage (S3 compatible) ----
S3_ENDPOINT=https://sea1.vultrobjects.com
S3_BUCKET=tether-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
